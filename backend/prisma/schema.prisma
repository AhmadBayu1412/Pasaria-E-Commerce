// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
 
// ============================================================
// Category MODEL (Phase 3 Step 2)
// ============================================================
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relasi: 1 Category → N Products
  products  Product[]

  @@index([name])
}

// ============================================================
// Product MODEL (Phase 3 Step 4 - Inventory Foundation)
// ============================================================
model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  price       Decimal
  // --- Inventory Fields (Phase 3 Step 4) ---
  availableStock Int     @default(0)  // Stok yang bisa dijual langsung
  reservedStock  Int     @default(0)  // Stok yang sudah di-reserve (cart)
  // totalStock = availableStock + reservedStock (computed, tidak disimpan)
  // -------------------------------------------
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

// ============================================================
// Ownership - Relasi ke user sebagai seller (Phase 2 Step 7)
// ============================================================
  sellerId    Int
  seller      User      @relation(fields: [sellerId], references: [id])

// Category Relation (Phase 3 Step 2) - Nullable
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])
}
 
// ============================================================
// Audit MODULE (Phase 1)
// ============================================================

model Audit {
  id         Int         @id @default(autoincrement())
  action     String      // CREATE_PRODUCT, UPDATE_PRODUCT, DELETE_PRODUCT
  entityType String      // "Product", "Order", dll
  entityId   Int          
  data       String      // JSON stringified
  requestId  String?     
  createdAt  DateTime    @default(now())
}

// ============================================================
// User MODEL (Phase 2 Step 1)
// ============================================================
enum UserRole {
  ADMIN
  SELLER
  CUSTOMER
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

// ============================================================
// Relasi Ownership - satu user bisa punya banyak product (Phase 2 Step 1)
// ============================================================
  products      Product[]
}