# ============================================================
# BACKEND ENVIRONMENT VARIABLES — PRODUCTION TEMPLATE
# Salin file ini ke .env dan isi nilainya di Render dashboard
# ============================================================

# Server
NODE_ENV=production
PORT=3001

# CORS — URL frontend Anda di Render
CORS_ORIGIN=https://pasaria-frontend.onrender.com

# Trust Proxy — 1 untuk Render (ada 1 proxy di depan)
TRUST_PROXY_COUNT=1

# ============ DATABASE ============
# Otomatis di-inject oleh Render dari PostgreSQL service
DATABASE_URL=postgresql://user:password@host:5432/pasaria?sslmode=require

# ============ REDIS ============
# Otomatis di-inject oleh Render dari Redis service
REDIS_URL=redis://user:password@host:6379

# ============ SESSION ============
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=GANTI-DENGAN-RANDOM-STRING-MINIMAL-64-KARAKTER

# Ganti dari default! Bisa apapun selain 'sessionId'
SESSION_COOKIE_NAME=__pasaria_sid

# TTL session dalam detik (default: 24 jam)
SESSION_TTL=86400

# Domain cookie (untuk subdomain sharing, opsional)
# SESSION_COOKIE_DOMAIN=.pasaria.com

# ============ SUPABASE STORAGE ============
# Dari: Supabase Dashboard → Settings → API
SUPABASE_URL=https://XXXXXXXXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJ...
SUPABASE_STORAGE_BUCKET=product-images
